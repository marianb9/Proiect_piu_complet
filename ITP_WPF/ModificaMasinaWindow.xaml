<Window x:Class="Proiect_PIU.ModificaMasinaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifică Mașină"
        Height="680" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F4F8">

    <Window.Resources>
        <SolidColorBrush x:Key="CuloarePrimara"      Color="#1A3C5E"/>
        <SolidColorBrush x:Key="CuloareEroare"       Color="#E74C3C"/>
        <SolidColorBrush x:Key="CuloareCard"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CuloareText"         Color="#2C3E50"/>
        <SolidColorBrush x:Key="CuloareTextSecundar" Color="#7F8C8D"/>

        <Style x:Key="LabelCamp" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareText}"/>
            <Setter Property="Padding"    Value="0,0,0,4"/>
        </Style>

        <Style x:Key="TextBoxNormal" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Height"     Value="34"/>
            <Setter Property="Padding"    Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StilRadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Margin"     Value="0,0,14,0"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareText}"/>
        </Style>

        <Style x:Key="StilCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Margin"     Value="0,4,14,4"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareText}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource CuloarePrimara}">
            <Label Content="Modifică Mașină"
                   FontFamily="Segoe UI Light" FontSize="18"
                   Foreground="White" VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- CONTINUT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,8">

                <!-- CARD: Selectare masina (ComboBox) -->
                <Border Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Margin="0,0,0,12" Padding="18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Label Content="SELECTEAZĂ MAȘINA" FontFamily="Segoe UI Semibold"
                               FontSize="11" Foreground="#2980B9" Padding="0,0,0,10"/>
                        <Label Content="Mașină" Style="{StaticResource LabelCamp}"/>
                        <ComboBox Name="cmbMasini"
                                  Height="34"
                                  FontFamily="Segoe UI"
                                  FontSize="13"
                                  DisplayMemberPath="NrInmatriculare"
                                  IsTextSearchEnabled="True"
                                  SelectionChanged="CmbMasini_SelectionChanged"/>
                        <TextBlock Name="lblNiciuMasina"
                                   Text="Nu există mașini salvate."
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{StaticResource CuloareTextSecundar}"
                                   Margin="0,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- CARD: Date masina (editabile) -->
                <Border Name="panelEditare" Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Margin="0,0,0,12" Padding="18,14"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Label Content="DATE MAȘINĂ" FontFamily="Segoe UI Semibold"
                               FontSize="11" Foreground="#2980B9" Padding="0,0,0,10"/>

                        <!-- Marca + Model -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Marcă" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtMarca" Style="{StaticResource TextBoxNormal}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Model" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtModel" Style="{StaticResource TextBoxNormal}"/>
                            </StackPanel>
                        </Grid>

                        <!-- An + Nr Inmatriculare -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="An fabricație" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtAn" Style="{StaticResource TextBoxNormal}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Nr. înmatriculare" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtNr" Style="{StaticResource TextBoxNormal}" IsReadOnly="True"
                                         Background="#F5F5F5" Foreground="#7F8C8D"/>
                            </StackPanel>
                        </Grid>

                        <!-- Culoare (RadioButton) -->
                        <StackPanel Margin="0,0,0,10">
                            <Label Content="Culoare" Style="{StaticResource LabelCamp}"/>
                            <WrapPanel Margin="0,4,0,0">
                                <RadioButton Name="rbRosu"     Content="Roșu"     GroupName="CuloareMod" Style="{StaticResource StilRadioButton}"/>
                                <RadioButton Name="rbAlb"      Content="Alb"      GroupName="CuloareMod" Style="{StaticResource StilRadioButton}" IsChecked="True"/>
                                <RadioButton Name="rbNegru"    Content="Negru"    GroupName="CuloareMod" Style="{StaticResource StilRadioButton}"/>
                                <RadioButton Name="rbAlbastru" Content="Albastru" GroupName="CuloareMod" Style="{StaticResource StilRadioButton}"/>
                                <RadioButton Name="rbGri"      Content="Gri"      GroupName="CuloareMod" Style="{StaticResource StilRadioButton}"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Dotari (CheckBox) -->
                        <StackPanel Margin="0,0,0,0">
                            <Label Content="Dotări" Style="{StaticResource LabelCamp}"/>
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox Name="ckbAer"       Content="Aer condiționat" Style="{StaticResource StilCheckBox}"/>
                                <CheckBox Name="ckbNavigatie" Content="Navigație"        Style="{StaticResource StilCheckBox}"/>
                                <CheckBox Name="ckbCutie"     Content="Cutie automată"   Style="{StaticResource StilCheckBox}"/>
                                <CheckBox Name="ckbSenzori"   Content="Senzori parcare"  Style="{StaticResource StilCheckBox}"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD: Proprietar -->
                <Border Name="panelProprietar" Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Margin="0,0,0,12" Padding="18,14"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Label Content="PROPRIETAR" FontFamily="Segoe UI Semibold"
                               FontSize="11" Foreground="#8E44AD" Padding="0,0,0,10"/>
                        <StackPanel Margin="0,0,0,10">
                            <Label Content="Nume" Style="{StaticResource LabelCamp}"/>
                            <TextBox Name="txtNumeProprietar" Style="{StaticResource TextBoxNormal}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="CNP" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtCNP" Style="{StaticResource TextBoxNormal}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Telefon" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtTelefon" Style="{StaticResource TextBoxNormal}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD: Istoric + DatePicker noua inspectie -->
                <Border Name="panelIstoric" Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Margin="0,0,0,12" Padding="18,14"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Label Content="ISTORIC INSPECȚII ITP" FontFamily="Segoe UI Semibold"
                               FontSize="11" Foreground="#27AE60" Padding="0,0,0,10"/>

                        <!-- ListBox - istoric -->
                        <Label Content="Inspecții anterioare" Style="{StaticResource LabelCamp}"/>
                        <ListBox Name="lstIstoric"
                                 Height="100"
                                 Margin="0,4,0,12"
                                 SelectionMode="Single"
                                 FontFamily="Segoe UI"
                                 FontSize="12"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"/>

                        <!-- DatePicker - noua inspectie -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Data nouă inspecție" Style="{StaticResource LabelCamp}"/>
                                <DatePicker Name="dtpDataInspectie"
                                            Height="34"
                                            FontFamily="Segoe UI"
                                            FontSize="13"
                                            SelectedDateFormat="Short"
                                            DisplayDateStart="2000-01-01"
                                            DisplayDateEnd="2030-12-31"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Rezultat" Style="{StaticResource LabelCamp}"/>
                                <ComboBox Name="cmbRezultat"
                                          Height="34"
                                          FontFamily="Segoe UI"
                                          FontSize="13">
                                    <ComboBoxItem Content="Admis" IsSelected="True"/>
                                    <ComboBoxItem Content="Respins"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mesaj succes -->
                <Border Name="panelSucces" Background="#D5F5E3"
                        BorderBrush="#27AE60" BorderThickness="1"
                        CornerRadius="6" Padding="14,10" Visibility="Collapsed">
                    <TextBlock Text="✓ Mașina a fost actualizată cu succes!"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="#1E8449"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- BUTOANE -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="20,0">
                <Button Content="Anulează"
                        Width="100" Height="36"
                        FontFamily="Segoe UI" FontSize="13"
                        Background="#ECF0F1" Foreground="#2C3E50"
                        BorderThickness="0" Margin="0,0,10,0"
                        Click="BtnAnuleaza_Click"/>
                <Button Name="btnActualizeaza" Content="Actualizează"
                        Width="120" Height="36"
                        FontFamily="Segoe UI Semibold" FontSize="13"
                        Background="{StaticResource CuloarePrimara}"
                        Foreground="White" BorderThickness="0"
                        IsEnabled="False"
                        Click="BtnActualizeaza_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
