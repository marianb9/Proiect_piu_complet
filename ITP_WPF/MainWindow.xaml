<Window x:Class="Proiect_PIU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem ITP"
        MinWidth="700" MinHeight="450"
        Width="1050" Height="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F0F4F8">

    <Window.Resources>
        <SolidColorBrush x:Key="CuloarePrimara"      Color="#1A3C5E"/>
        <SolidColorBrush x:Key="CuloareSecundara"    Color="#2980B9"/>
        <SolidColorBrush x:Key="CuloareAccent"       Color="#27AE60"/>
        <SolidColorBrush x:Key="CuloareAvertizare"   Color="#E74C3C"/>
        <SolidColorBrush x:Key="CuloareCard"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CuloareText"         Color="#2C3E50"/>
        <SolidColorBrush x:Key="CuloareTextSecundar" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="CuloareMeniu"        Color="#152D46"/>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareText}"/>
            <Setter Property="Padding"    Value="0"/>
        </Style>

        <Style x:Key="BtnMeniu" TargetType="Button">
            <Setter Property="FontFamily"            Value="Segoe UI"/>
            <Setter Property="FontSize"              Value="13"/>
            <Setter Property="Foreground"            Value="#A9CCE3"/>
            <Setter Property="Background"            Value="Transparent"/>
            <Setter Property="BorderThickness"       Value="0"/>
            <Setter Property="Height"                Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"               Value="20,0"/>
            <Setter Property="Cursor"                Value="Hand"/>
        </Style>

        <Style x:Key="BtnMeniuActiv" TargetType="Button" BasedOn="{StaticResource BtnMeniu}">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Background"  Value="#2980B9"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <Style x:Key="LabelCamp" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareTextSecundar}"/>
            <Setter Property="Padding"    Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- MENIU LATERAL -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Background="{StaticResource CuloareMeniu}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,16">
                    <Label Content="Sistem ITP"
                           FontFamily="Segoe UI Light" FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center" Padding="0"/>
                    <Label Content="Inspectii Tehnice Auto"
                           FontFamily="Segoe UI" FontSize="11"
                           Foreground="#5D8AA8"
                           HorizontalAlignment="Center" Padding="0"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Height="1"
                        Background="#2C4A6A" Margin="16,0,16,8"/>

                <StackPanel DockPanel.Dock="Top">
                    <Button Name="btnMeniuLista"
                            Content="Lista Masini"
                            Style="{StaticResource BtnMeniuActiv}"
                            Click="BtnMeniuLista_Click"/>
                    <Button Name="btnMeniuAdauga"
                            Content="Adauga Masina"
                            Style="{StaticResource BtnMeniu}"
                            Click="BtnMeniuAdauga_Click"/>
                    <Button Name="btnMeniuCauta"
                            Content="Cauta Masina"
                            Style="{StaticResource BtnMeniu}"
                            Click="BtnMeniuCauta_Click"/>
                    <Button Name="btnMeniuInspectii"
                            Content="Inspectii CRUD"
                            Style="{StaticResource BtnMeniu}"
                            Click="BtnMeniuInspectii_Click"/>
                    <Button Name="btnMeniuModifica"
                            Content="Modifica Masina"
                            Style="{StaticResource BtnMeniu}"
                            Click="BtnMeniuModifica_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                    <Border Height="1" Background="#2C4A6A" Margin="16,0,16,10"/>
                    <Label Content="2025 Sistem ITP"
                           FontSize="10" Foreground="#5D8AA8"
                           HorizontalAlignment="Center" Padding="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CONTINUT PRINCIPAL -->
        <Grid Grid.Column="1" Grid.Row="0">

            <!-- SECTIUNEA LISTA MASINI -->
            <Grid Name="panelLista" Visibility="Visible" Margin="24,20,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titlu + buton refresh -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Label Content="Lista Masini"
                           FontFamily="Segoe UI Light" FontSize="22"
                           Foreground="{StaticResource CuloarePrimara}"
                           Padding="0" VerticalAlignment="Center"/>
                    <Button Content="Reincarca"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="100" Height="32"
                            FontFamily="Segoe UI" FontSize="12"
                            Background="{StaticResource CuloareSecundara}"
                            Foreground="White" BorderThickness="0"
                            Click="BtnReincarca_Click"/>
                </Grid>

                <!-- Sumar -->
                <Border Grid.Row="1" Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Margin="0,0,0,12" Padding="18,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,40,0">
                            <Label Content="TOTAL MASINI" Style="{StaticResource LabelCamp}"/>
                            <!-- Binding la DataGrid.Items.Count -->
                            <Label Content="{Binding ElementName=dgMasini, Path=Items.Count}"
                                   FontFamily="Segoe UI Semibold" FontSize="22"
                                   Foreground="{StaticResource CuloarePrimara}" Padding="0"/>
                        </StackPanel>
                        <StackPanel>
                            <Label Content="FISIER DATE" Style="{StaticResource LabelCamp}"/>
                            <Label Content="Masini.txt"
                                   FontFamily="Segoe UI" FontSize="14"
                                   Foreground="{StaticResource CuloareTextSecundar}" Padding="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- DataGrid masini -->
                <Border Grid.Row="2" Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Padding="18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Background="{StaticResource CuloareSecundara}"
                                    CornerRadius="2" Margin="0,0,8,0"/>
                            <Label Content="TOATE MASINILE"
                                   FontFamily="Segoe UI Semibold" FontSize="11"
                                   Foreground="{StaticResource CuloareSecundara}"
                                   Padding="0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" Name="dgMasini"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  AlternatingRowBackground="#F5F5F5"
                                  RowHeight="30"
                                  FontFamily="Segoe UI"
                                  FontSize="13">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nr. Inmatriculare" Binding="{Binding NrInmatriculare}" Width="150"/>
                                <DataGridTextColumn Header="Marca"             Binding="{Binding Marca}"           Width="*"/>
                                <DataGridTextColumn Header="Model"             Binding="{Binding Model}"           Width="*"/>
                                <DataGridTextColumn Header="An Fabricatie"     Binding="{Binding AnFabricatie}"    Width="110"/>
                                <DataGridTextColumn Header="Proprietar"        Binding="{Binding Proprietar.Nume}" Width="*"/>
                                <DataGridTextColumn Header="Telefon"           Binding="{Binding Proprietar.Telefon}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- SECTIUNEA CAUTARE -->
            <Grid Name="panelCauta" Visibility="Collapsed" Margin="24,20,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Cauta Masina"
                       FontFamily="Segoe UI Light" FontSize="22"
                       Foreground="{StaticResource CuloarePrimara}"
                       Padding="0" Margin="0,0,0,14"/>

                <Border Grid.Row="1" Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="Cauta dupa" Style="{StaticResource LabelCamp}" Margin="0,0,0,4"/>
                            <ComboBox Name="cmbCriteriuCautare"
                  Height="34" FontFamily="Segoe UI" FontSize="13"
                  SelectedIndex="0">
                                <ComboBoxItem Content="Nr. Inmatriculare"/>
                                <ComboBoxItem Content="Marca"/>
                                <ComboBoxItem Content="Model"/>
                                <ComboBoxItem Content="Proprietar"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="Termen cautare" Style="{StaticResource LabelCamp}" Margin="0,0,0,4"/>
                            <TextBox Name="txtCautare"
                 FontFamily="Segoe UI" FontSize="13"
                 Height="34" Padding="8,0"
                 VerticalContentAlignment="Center"
                 BorderBrush="#BDC3C7" BorderThickness="1"
                 TextChanged="TxtCautare_TextChanged"
                 KeyDown="TxtCautare_KeyDown"/>
                        </StackPanel>

                        <Button Grid.Column="4" Content="Cauta"
            Height="34" Width="90"
            FontFamily="Segoe UI Semibold" FontSize="13"
            Background="{StaticResource CuloareSecundara}"
            Foreground="White" BorderThickness="0"
            VerticalAlignment="Bottom"
            Click="BtnCauta_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Padding="18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Background="{StaticResource CuloareSecundara}"
                                    CornerRadius="2" Margin="0,0,8,0"/>
                            <Label Name="lblRezultateHeader" Content="REZULTATE"
                                   FontFamily="Segoe UI Semibold" FontSize="11"
                                   Foreground="{StaticResource CuloareSecundara}"
                                   Padding="0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Label Name="lblMesajCautare" Grid.Row="1"
                               Content="Introduceti un numar de inmatriculare si apasati Cauta."
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource CuloareTextSecundar}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <DataGrid Name="dgRezultate" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  AlternatingRowBackground="#F5F5F5"
                                  RowHeight="30"
                                  FontFamily="Segoe UI" FontSize="13"
                                  Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nr. Inmatriculare" Binding="{Binding NrInmatriculare}" Width="160"/>
                                <DataGridTextColumn Header="Marca"             Binding="{Binding Marca}"           Width="*"/>
                                <DataGridTextColumn Header="Model"             Binding="{Binding Model}"           Width="*"/>
                                <DataGridTextColumn Header="An"                Binding="{Binding AnFabricatie}"    Width="70"/>
                                <DataGridTextColumn Header="Proprietar"        Binding="{Binding Proprietar.Nume}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- FOOTER -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="#E8EDF2"
                BorderBrush="#D0D7DE" BorderThickness="0,1,0,0">
            <Label Name="lblStatus"
                   Content="Aplicatie de gestionare a inspectiilor tehnice periodice auto."
                   FontFamily="Segoe UI" FontSize="11"
                   Foreground="{StaticResource CuloareTextSecundar}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
