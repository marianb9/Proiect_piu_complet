<Window x:Class="Proiect_PIU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem ITP"
        MinWidth="700" MinHeight="450"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F0F4F8">

    <Window.Resources>
        <SolidColorBrush x:Key="CuloarePrimara"      Color="#1A3C5E"/>
        <SolidColorBrush x:Key="CuloareSecundara"    Color="#2980B9"/>
        <SolidColorBrush x:Key="CuloareAccent"       Color="#27AE60"/>
        <SolidColorBrush x:Key="CuloareAvertizare"   Color="#E74C3C"/>
        <SolidColorBrush x:Key="CuloareCard"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CuloareText"         Color="#2C3E50"/>
        <SolidColorBrush x:Key="CuloareTextSecundar" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="CuloareMeniu"        Color="#152D46"/>

        <!-- Stil global Label -->
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareText}"/>
            <Setter Property="Padding"    Value="0"/>
        </Style>

        <!-- Stil buton meniu -->
        <Style x:Key="BtnMeniu" TargetType="Button">
            <Setter Property="FontFamily"            Value="Segoe UI"/>
            <Setter Property="FontSize"              Value="13"/>
            <Setter Property="Foreground"            Value="#A9CCE3"/>
            <Setter Property="Background"            Value="Transparent"/>
            <Setter Property="BorderThickness"       Value="0"/>
            <Setter Property="Height"                Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"               Value="20,0"/>
            <Setter Property="Cursor"                Value="Hand"/>
        </Style>

        <!-- Stil buton meniu activ -->
        <Style x:Key="BtnMeniuActiv" TargetType="Button" BasedOn="{StaticResource BtnMeniu}">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Background"  Value="#2980B9"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- Stil LabelCamp -->
        <Style x:Key="LabelCamp" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareTextSecundar}"/>
            <Setter Property="Padding"    Value="0"/>
        </Style>

        <!-- Stil LabelValoare -->
        <Style x:Key="LabelValoare" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareText}"/>
            <Setter Property="Padding"    Value="0"/>
        </Style>

        <!-- Stil TextBox cautare -->
        <Style x:Key="TextBoxCautare" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Height"     Value="34"/>
            <Setter Property="Padding"    Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Stil Button actiune -->
        <Style x:Key="BtnActiune" TargetType="Button">
            <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Layout principal: Grid cu meniu stanga + continut dreapta -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- ===== MENIU LATERAL ===== -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Background="{StaticResource CuloareMeniu}">
            <DockPanel>
                <!-- Logo / Titlu meniu -->
                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,20">
                    <Label Content="🚗 Sistem ITP"
                           FontFamily="Segoe UI Light"
                           FontSize="17"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Padding="0"/>
                    <Label Content="Gestionare Inspecții"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#5D8AA8"
                           HorizontalAlignment="Center"
                           Padding="0"/>
                </StackPanel>

                <!-- Separator -->
                <Border DockPanel.Dock="Top" Height="1"
                        Background="#2C4A6A" Margin="16,0,16,8"/>

                <!-- Butoane meniu -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Name="btnMeniuDetalii"
                            Content="📋  Detalii Mașină"
                            Style="{StaticResource BtnMeniuActiv}"
                            Click="BtnMeniuDetalii_Click"/>
                    <Button Name="btnMeniuAdauga"
                            Content="➕  Adaugă Mașină"
                            Style="{StaticResource BtnMeniu}"
                            Click="BtnMeniuAdauga_Click"/>
                    <Button Name="btnMeniuCauta"
                            Content="🔍  Caută Mașină"
                            Style="{StaticResource BtnMeniu}"
                            Click="BtnMeniuCauta_Click"/>
                    <Button Name="btnMeniuModifica"
                             Content="✏️  Modifică Mașină"
                             Style="{StaticResource BtnMeniu}"
                             Click="BtnMeniuModifica_Click"/>
                    <Button Content="📋  Inspecții CRUD" Style="{StaticResource BtnMeniu}" Click="BtnMeniuInspectii_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <Border Height="1" Background="#2C4A6A" Margin="16,0,16,12"/>
                    <Label Content="© 2025 Sistem ITP"
                           FontSize="10" Foreground="#5D8AA8"
                           HorizontalAlignment="Center" Padding="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== CONTINUT PRINCIPAL ===== -->
        <Grid Grid.Column="1" Grid.Row="0">

            <!-- == SECTIUNEA DETALII == -->
            <ScrollViewer Name="panelDetalii"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Visible">
                <StackPanel Margin="24,20,24,16">

                    <Label Content="Detalii Mașină"
                           FontFamily="Segoe UI Light" FontSize="22"
                           Foreground="{StaticResource CuloarePrimara}"
                           Margin="0,0,0,16" Padding="0"/>

                    <!-- CARD: Date Masina -->
                    <Border Background="{StaticResource CuloareCard}"
                            CornerRadius="10" Margin="0,0,0,14" Padding="22,18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#BBBBBB" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="3" Background="{StaticResource CuloareSecundara}" CornerRadius="2" Margin="0,0,8,0"/>
                                <Label Content="DATE MAȘINĂ" FontFamily="Segoe UI Semibold" FontSize="12"
                                       Foreground="{StaticResource CuloareSecundara}" Padding="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,12">
                                    <Label Content="NR. ÎNMATRICULARE" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblNrInmatriculare" Style="{StaticResource LabelValoare}" FontSize="17" Foreground="{StaticResource CuloarePrimara}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,16,12">
                                    <Label Content="MARCĂ / MODEL" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblMarcaModel" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,12">
                                    <Label Content="AN FABRICAȚIE" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblAnFabricatie" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,16,0">
                                    <Label Content="CULOARE" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblCuloare" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,16,0">
                                    <Label Content="DOTĂRI" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblDotari" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD: Proprietar -->
                    <Border Background="{StaticResource CuloareCard}"
                            CornerRadius="10" Margin="0,0,0,14" Padding="22,18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#BBBBBB" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="3" Background="#8E44AD" CornerRadius="2" Margin="0,0,8,0"/>
                                <Label Content="PROPRIETAR" FontFamily="Segoe UI Semibold" FontSize="12"
                                       Foreground="#8E44AD" Padding="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <Label Content="NUME" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblProprietarNume" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <Label Content="CNP" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblProprietarCNP" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="TELEFON" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblProprietarTelefon" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD: Ultima Inspectie -->
                    <Border Background="{StaticResource CuloareCard}"
                            CornerRadius="10" Margin="0,0,0,14" Padding="22,18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#BBBBBB" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="3" Background="{StaticResource CuloareAccent}" CornerRadius="2" Margin="0,0,8,0"/>
                                <Label Content="ULTIMA INSPECȚIE ITP" FontFamily="Segoe UI Semibold" FontSize="12"
                                       Foreground="{StaticResource CuloareAccent}" Padding="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <Label Content="REZULTAT" Style="{StaticResource LabelCamp}"/>
                                    <Border Name="badgeRezultat" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <Label Name="lblRezultat" FontFamily="Segoe UI Semibold" FontSize="13" Padding="0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <Label Content="DATA INSPECȚIEI" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblDataInspectie" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <Label Content="VALABIL PÂNĂ LA" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblValabilPana" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <Label Content="INSPECTOR" Style="{StaticResource LabelCamp}"/>
                                    <Label Name="lblInspector" Style="{StaticResource LabelValoare}"/>
                                </StackPanel>
                            </Grid>
                            <Border Name="panelDefectiuni" Margin="0,12,0,0" Background="#FEF9E7"
                                    CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Defecțiuni:" Style="{StaticResource LabelCamp}"
                                           Foreground="#B7950B" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Label Name="lblDefectiuni" FontFamily="Segoe UI" FontSize="13"
                                           Foreground="#7D6608" Padding="0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- AVERTIZARE -->
                    <Border Name="panelAvertizare" Background="#FDEDEC"
                            BorderBrush="{StaticResource CuloareAvertizare}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="⚠" FontSize="16" Padding="0,0,10,0"
                                   Foreground="{StaticResource CuloareAvertizare}" VerticalAlignment="Center"/>
                            <Label Name="lblAvertizare" FontFamily="Segoe UI Semibold" FontSize="13"
                                   Foreground="{StaticResource CuloareAvertizare}" Padding="0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- == SECTIUNEA CAUTARE == -->
            <Grid Name="panelCauta" Visibility="Collapsed" Margin="24,20,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Caută Mașină"
                       FontFamily="Segoe UI Light" FontSize="22"
                       Foreground="{StaticResource CuloarePrimara}"
                       Margin="0,0,0,16" Padding="0"/>

                <!-- Bara de cautare -->
                <Border Grid.Row="1" Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Padding="18,14" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Număr înmatriculare" Style="{StaticResource LabelCamp}" Margin="0,0,0,4"/>
                            <TextBox Name="txtCautare" Style="{StaticResource TextBoxCautare}"
                                     KeyDown="TxtCautare_KeyDown"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Caută"
                                Style="{StaticResource BtnActiune}"
                                Background="{StaticResource CuloareSecundara}"
                                VerticalAlignment="Bottom"
                                Click="BtnCauta_Click"/>
                    </Grid>
                </Border>

                <!-- Rezultate -->
                <Border Grid.Row="2" Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Padding="18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Background="{StaticResource CuloareSecundara}" CornerRadius="2" Margin="0,0,8,0"/>
                            <Label Content="REZULTATE" FontFamily="Segoe UI Semibold" FontSize="12"
                                   Foreground="{StaticResource CuloareSecundara}" Padding="0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Mesaj lipsa rezultate -->
                        <Label Name="lblMesajCautare"
                               Grid.Row="1"
                               Content="Introduceți un număr de înmatriculare și apăsați Caută."
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource CuloareTextSecundar}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>

                        <!-- DataGrid rezultate -->
                        <DataGrid Name="dgRezultate"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  AlternatingRowBackground="#F5F5F5"
                                  RowHeight="28"
                                  Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nr. Înmatriculare" Binding="{Binding NrInmatriculare}" Width="160"/>
                                <DataGridTextColumn Header="Marcă" Binding="{Binding Marca}" Width="*"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                                <DataGridTextColumn Header="An" Binding="{Binding AnFabricatie}" Width="70"/>
                                <DataGridTextColumn Header="Proprietar" Binding="{Binding Proprietar.Nume}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- FOOTER -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="#E8EDF2"
                BorderBrush="#D0D7DE" BorderThickness="0,1,0,0">
            <Label Content="© 2025 Sistem ITP  |  Proiectare Interfețe Utilizator"
                   FontFamily="Segoe UI" FontSize="11"
                   Foreground="{StaticResource CuloareTextSecundar}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
