<Window x:Class="Proiect_PIU.AdaugaMasinaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adauga Masina Noua"
        Height="680" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F4F8">

    <Window.Resources>
        <SolidColorBrush x:Key="CuloarePrimara"    Color="#1A3C5E"/>
        <SolidColorBrush x:Key="CuloareEroare"     Color="#E74C3C"/>
        <SolidColorBrush x:Key="CuloareCard"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CuloareText"       Color="#2C3E50"/>
        <SolidColorBrush x:Key="CuloareTextSecundar" Color="#7F8C8D"/>

        <!-- Stil Label camp -->
        <Style x:Key="LabelCamp" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareText}"/>
            <Setter Property="Padding"    Value="0,0,0,4"/>
        </Style>

        <!-- Stil TextBox cu binding si validare -->
        <Style x:Key="TextBoxBinding" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Height"     Value="34"/>
            <Setter Property="Padding"    Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Stil mesaj eroare sub camp -->
        <Style x:Key="TextEroare" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource CuloareEroare}"/>
            <Setter Property="Margin"     Value="0,2,0,0"/>
        </Style>

        <Style x:Key="StilRadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Margin"     Value="0,0,14,0"/>
        </Style>

        <Style x:Key="StilCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Margin"     Value="0,4,14,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource CuloarePrimara}">
            <Label Content="Adauga Masina Noua"
                   FontFamily="Segoe UI Light" FontSize="18"
                   Foreground="White" VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- CONTINUT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,8">

                <!-- CARD: Date Masina -->
                <Border Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Margin="0,0,0,12" Padding="18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Label Content="DATE MASINA" FontFamily="Segoe UI Semibold"
                               FontSize="11" Foreground="#2980B9" Padding="0,0,0,10"/>

                        <!-- Marca + Model cu BINDING TwoWay + ValidatesOnDataErrors -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Marca" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtMarca" Style="{StaticResource TextBoxBinding}"
                                         Text="{Binding Marca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                                <!-- Mesaj eroare din IDataErrorInfo prin binding -->
                                <TextBlock Style="{StaticResource TextEroare}"
                                           Text="{Binding ElementName=txtMarca, Path=(Validation.Errors)/ErrorContent}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Model" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtModel" Style="{StaticResource TextBoxBinding}"
                                         Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                                <TextBlock Style="{StaticResource TextEroare}"
                                           Text="{Binding ElementName=txtModel, Path=(Validation.Errors)/ErrorContent}"/>
                            </StackPanel>
                        </Grid>

                        <!-- An + Nr Inmatriculare -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="An fabricatie" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtAn" Style="{StaticResource TextBoxBinding}"
                                         Text="{Binding An, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                                <TextBlock Style="{StaticResource TextEroare}"
                                           Text="{Binding ElementName=txtAn, Path=(Validation.Errors)/ErrorContent}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Nr. inmatriculare" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtNr" Style="{StaticResource TextBoxBinding}"
                                         Text="{Binding NrInmatriculare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                                <TextBlock Style="{StaticResource TextEroare}"
                                           Text="{Binding ElementName=txtNr, Path=(Validation.Errors)/ErrorContent}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Culoare (RadioButton) -->
                        <StackPanel Margin="0,0,0,4">
                            <Label Content="Culoare" Style="{StaticResource LabelCamp}"/>
                            <WrapPanel Margin="0,4,0,0">
                                <RadioButton Name="rbRosu"     Content="Rosu"     GroupName="Culoare" Style="{StaticResource StilRadioButton}"/>
                                <RadioButton Name="rbAlb"      Content="Alb"      GroupName="Culoare" Style="{StaticResource StilRadioButton}" IsChecked="True"/>
                                <RadioButton Name="rbNegru"    Content="Negru"    GroupName="Culoare" Style="{StaticResource StilRadioButton}"/>
                                <RadioButton Name="rbAlbastru" Content="Albastru" GroupName="Culoare" Style="{StaticResource StilRadioButton}"/>
                                <RadioButton Name="rbGri"      Content="Gri"      GroupName="Culoare" Style="{StaticResource StilRadioButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD: Dotari (CheckBox) -->
                <Border Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Margin="0,0,0,12" Padding="18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Label Content="DOTARI" FontFamily="Segoe UI Semibold"
                               FontSize="11" Foreground="#27AE60" Padding="0,0,0,10"/>
                        <WrapPanel>
                            <CheckBox Name="ckbAer"       Content="Aer conditionat" Style="{StaticResource StilCheckBox}"/>
                            <CheckBox Name="ckbNavigatie" Content="Navigatie"        Style="{StaticResource StilCheckBox}"/>
                            <CheckBox Name="ckbCutie"     Content="Cutie automata"   Style="{StaticResource StilCheckBox}"/>
                            <CheckBox Name="ckbSenzori"   Content="Senzori parcare"  Style="{StaticResource StilCheckBox}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- CARD: Proprietar -->
                <Border Background="{StaticResource CuloareCard}"
                        CornerRadius="8" Margin="0,0,0,12" Padding="18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <Label Content="DATE PROPRIETAR" FontFamily="Segoe UI Semibold"
                               FontSize="11" Foreground="#8E44AD" Padding="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,10">
                            <Label Content="Nume proprietar" Style="{StaticResource LabelCamp}"/>
                            <TextBox Name="txtNumeProprietar" Style="{StaticResource TextBoxBinding}"
                                     Text="{Binding NumeProprietar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                            <TextBlock Style="{StaticResource TextEroare}"
                                       Text="{Binding ElementName=txtNumeProprietar, Path=(Validation.Errors)/ErrorContent}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="CNP" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtCNP" Style="{StaticResource TextBoxBinding}"
                                         Text="{Binding CNP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                                <TextBlock Style="{StaticResource TextEroare}"
                                           Text="{Binding ElementName=txtCNP, Path=(Validation.Errors)/ErrorContent}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Telefon" Style="{StaticResource LabelCamp}"/>
                                <TextBox Name="txtTelefon" Style="{StaticResource TextBoxBinding}"
                                         Text="{Binding Telefon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                                <TextBlock Style="{StaticResource TextEroare}"
                                           Text="{Binding ElementName=txtTelefon, Path=(Validation.Errors)/ErrorContent}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mesaj succes -->
                <Border Name="panelSucces" Background="#D5F5E3"
                        BorderBrush="#27AE60" BorderThickness="1"
                        CornerRadius="6" Padding="14,10" Visibility="Collapsed">
                    <TextBlock Text="Masina a fost adaugata cu succes!"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               Foreground="#1E8449"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- BUTOANE -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="20,0">
                <Button Content="Reset"
                        Width="90" Height="36"
                        FontFamily="Segoe UI" FontSize="13"
                        Background="#ECF0F1" Foreground="#2C3E50"
                        BorderThickness="0" Margin="0,0,10,0"
                        Click="BtnReset_Click"/>
                <!-- Butonul Adauga e activat automat prin binding la EsteValid -->
                <Button Content="Adauga"
                        Width="110" Height="36"
                        FontFamily="Segoe UI Semibold" FontSize="13"
                        Background="{StaticResource CuloarePrimara}"
                        Foreground="White" BorderThickness="0"
                        IsEnabled="{Binding EsteValid}"
                        Click="BtnAdauga_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
